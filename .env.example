# Copy to .env.local and fill in. Never commit the filled-in file.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com

# The From address. Resend only accepts a domain you have verified at
# https://resend.com/domains — e.g. hello@yourdomain.com
# For testing before you verify a domain, use onboarding@resend.dev, which can
# only deliver to the email address on your own Resend account.
CONTACT_FROM_EMAIL=onboarding@resend.dev
